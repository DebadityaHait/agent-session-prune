{
  "name": "agent-session-prune",
  "version": "0.1.0",
  "description": "Find, archive, and safely reclaim coding-agent session storage before it eats your disk.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "bin": { "agent-prune": "./dist/cli.js" },
  "engines": { "node": ">=20" },
  "files": ["dist", "README.md", "LICENSE", "SECURITY.md", "CHANGELOG.md"],
  "scripts": { "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli.js',0o755); require('node:fs').rmSync('dist/test',{recursive:true,force:true})\"", "lint": "tsc -p tsconfig.json --noEmit", "typecheck": "tsc -p tsconfig.json --noEmit", "test": "npm run build:test && node --test dist/test/*.test.js", "build:test": "tsc -p tsconfig.json", "test:cli": "npm run build && node dist/cli.js --help && node -e \"const {spawnSync}=require('node:child_process'); const r=spawnSync(process.execPath,['dist/cli.js','audit','--json'],{stdio:'ignore'}); if(r.status!==0&&r.status!==1) process.exit(r.status??2)\"", "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"" },
  "repository": { "type": "git", "url": "https://github.com/DebadityaHait/agent-session-prune.git" },
  "homepage": "https://github.com/DebadityaHait/agent-session-prune#readme",
  "bugs": { "url": "https://github.com/DebadityaHait/agent-session-prune/issues" },
  "license": "MIT",
  "publishConfig": { "access": "public", "provenance": true },
  "devDependencies": { "@types/node": "^22.10.0", "typescript": "^5.7.2" }
}
